---
/* Technical Project Showcase Block */
---

<div class="border-t border-slate-100 dark:border-slate-900 pt-20">
  <a
    href="/projects"
    class="group relative block overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#020617] p-8 md:p-14 transition-all"
  >
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
      
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-1.5 w-1.5 rounded-full bg-slate-900 dark:bg-white"></div>
          <span class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-500">
            Technical Documentation
          </span>
        </div>
        
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-6 tracking-tighter leading-[1.1]">
          Explore My <br /> 
          <span class="text-slate-400 dark:text-slate-500">Project Builds</span>
        </h2>
        
        <p class="max-w-xl text-base md:text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
          Detailed overviews of full-stack implementations, system architecture choices, and technical execution.
        </p>
      </div>

      <div class="shrink-0">
        <div class="inline-flex items-center justify-center px-8 py-4 bg-[#0f172a] dark:bg-white text-white dark:text-[#0f172a] rounded-lg font-bold text-sm transition-all group-hover:bg-slate-800 dark:group-hover:bg-slate-200 shadow-sm">
          View All Projects
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </div>

    </div>

    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none" 
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;">
    </div>
  </a>
</div>